<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<HBox minHeight="600.0" minWidth="800.0" prefWidth="902.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" minHeight="10.0" prefHeight="47.0" prefWidth="902.0" spacing="20.0" style="-fx-background-color: gray; -fx-padding: 20;" VBox.vgrow="NEVER">
               <children>
                  <Button fx:id="backButton" mnemonicParsing="false" text="Back" />
               </children>
            </HBox>
            <Label text="View Bookings">
               <font>
                  <Font name="System Bold" size="41.0" />
               </font>
            </Label>
            <ScrollPane hbarPolicy="NEVER" maxHeight="400.0" maxWidth="700.0" minHeight="300.0" minWidth="700.0" prefHeight="358.0" prefWidth="766.0" style="-fx-background-color: grey;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="bookingsVBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="700.0" prefWidth="700.0" />
               </content>
            </ScrollPane>
            <Label fx:id="alertLabel" alignment="CENTER" contentDisplay="TOP" prefHeight="18.0" prefWidth="579.0" text="PLACEHOLDER ALERT TEXT" />
         </children>
      </VBox>
   </children>
</HBox>
